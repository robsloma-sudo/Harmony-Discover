{
  "name": "harmony-discover",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:learning": "vitest run tests/learning-ingest-policy.test.ts",
    "test:voice": "vitest run tests/voice-session-state.test.ts tests/voice-session-contract.test.ts tests/voice-session-client.test.ts tests/voice-session-coordinator.test.ts",
    "prebuild:ios": "expo prebuild --platform ios",
    "build:dev:ios": "eas build --profile development --platform ios",
    "doctor": "expo-doctor",
    "build:web": "expo export --platform web",
    "test:marty": "vitest run tests/marty-profile.test.ts",
    "test:all": "vitest run",
    "build:edge": "node scripts/build-edge.mjs",
    "prebuild:web": "node scripts/copy-ort-wasm.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.49.1",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-camera": "~16.0.10",
    "expo-dev-client": "~5.0.20",
    "expo-font": "~13.0.4",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-router": "~4.0.17",
    "expo-status-bar": "~2.0.1",
    "onnxruntime-web": "1.31.1",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "react-native-webrtc": "124.0.4",
    "zod": "^3.24.1"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "devDependencies": {
    "@config-plugins/react-native-webrtc": "10.0.0",
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3",
    "vitest": "^2.1.8"
  }
}
